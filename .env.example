# Database
POSTGRES_USER=payment_user
POSTGRES_PASSWORD=payment_pass
POSTGRES_DB=payment_gateway
DATABASE_URL=postgresql://payment_user:payment_pass@postgres:5432/payment_gateway

# Redis
REDIS_URL=redis://redis:6379/0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=your-secret-key-change-in-production
API_ENVIRONMENT=development

# Gateway Credentials - Stripe
STRIPE_API_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Gateway Credentials - PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=your_webhook_id

# Gateway Credentials - Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=your_mercadopago_access_token
MERCADOPAGO_PUBLIC_KEY=your_mercadopago_public_key
MERCADOPAGO_WEBHOOK_SECRET=your_webhook_secret

# Gateway Credentials - PagSeguro
PAGSEGURO_EMAIL=your_email@example.com
PAGSEGURO_TOKEN=your_pagseguro_token
PAGSEGURO_ENVIRONMENT=sandbox

# Security
ENCRYPTION_KEY=your-encryption-key-32-chars-min
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Retry Configuration
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=60

# Frontend
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
